# Deployed configuration for the Stride/Keap integration box.
# Copy to .env on the server and fill in the real values.

APP_ENV=production
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Database -----------------------------------------------------------
# sslmode=require is enforced when APP_ENV is a deployed environment.
SUPABASE_DB_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require

# --- Providers: everything real. Mocks are for local tests only. --------
PROVIDER_MODE=real
VAPI_MODE=real
TWILIO_MODE=real
STRIDE_MODE=real
# Old Keap handoff webhook only (not the contact sync: KEAP_SYNC_ENABLED). KEAP_MODE still works.
KEAP_HANDOFF_MODE=real

# --- Cadence acceleration (disabled in production) -----------------------
# Enable only in a controlled development environment. When enabled, test
# leads use TEST_CADENCE_DAY_MINUTES instead of real cadence days.
TEST_MODE=false
TEST_CADENCE_DAY_MINUTES=1

# --- URLs ---------------------------------------------------------------
API_BASE_URL=http://api:8000
PUBLIC_BASE_URL=https://stride.aibolt.ai

# --- Dashboard (CRM) -----------------------------------------------------
# Server-to-server token for /api/v1/dashboard/*. Generate with: openssl rand -hex 32
# Must be at least 32 characters. Never expose in a browser/NEXT_PUBLIC_* variable.
DASHBOARD_API_TOKEN=
# Browser-facing dashboard origin used to build authenticated transcript links.
DASHBOARD_PUBLIC_URL=https://rpt-frontend-pi.vercel.app

# --- Google Sheets / n8n -----------------------------------------------
# Inbound n8n requests are disabled until both values are configured.
# Generate independent secrets for each direction: openssl rand -hex 32
N8N_INTAKE_KEY_ID=rausch-pt-sheets
N8N_INTAKE_SECRET=
# Local testing only. Set true to skip HMAC intake auth when APP_ENV=development.
N8N_INTAKE_AUTH_DISABLED=false
N8N_PRACTICE_SLUG=rausch-pt

# Outbound Sheet updates are feature-gated. Keep false until the production
# n8n webhook, Google credentials, and protected Sheet columns are verified.
SHEET_SYNC_ENABLED=true
N8N_SHEET_WEBHOOK_URL=https://n8n.example.com/webhook/rpt-sheet-updates
N8N_SHEET_KEY_ID=aws-sheet-sync
N8N_SHEET_WEBHOOK_SECRET=
SHEET_SYNC_POLL_SECONDS=30
SHEET_SYNC_BATCH_SIZE=20
SHEET_SYNC_HTTP_TIMEOUT_SECONDS=10
# n8n (old) or direct (sheet-worker reads/writes the Google Sheet itself; turn the n8n Sheet
# workflows off first). The key file lives outside the repo and is mounted read-only.
SHEET_SYNC_MODE=n8n
# Leads come only from the Sheet; true re-enables the dashboard's Add lead.
DASHBOARD_LEAD_CREATE_ENABLED=false
GOOGLE_SHEET_CREDENTIALS_FILE=/run/secrets/google-sheet-sa.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1
GOOGLE_SHEET_HEADER_ROW=2
SHEET_STUCK_SECONDS=120
SHEET_FULL_READ_SECONDS=300
SHEET_SETTLE_SECONDS=60
SHEET_MAX_COMMANDS_PER_POLL=50
SHEET_ARCHIVE_ENABLED=false
SHEET_ARCHIVE_DAYS=30
SHEET_ARCHIVE_HOUR=3
GOOGLE_SHEET_ARCHIVE_TAB=Archive

# --- Stride CSV import (stride-worker) ------------------------------------
# Stride uploads CSV exports over SFTP. Paths are inside the container; the
# compose file mounts the host SFTP inbox, archive and error folders there.
STRIDE_IMPORT_ENABLED=false
STRIDE_PRACTICE_SLUG=rausch-pt
STRIDE_INBOX_DIR=/app/stride/incoming
STRIDE_ARCHIVE_DIR=/app/stride/archive
STRIDE_ERROR_DIR=/app/stride/error
STRIDE_IMPORT_POLL_SECONDS=60
STRIDE_FILE_SETTLE_SECONDS=60
STRIDE_IMPORT_MAX_ATTEMPTS=3
STRIDE_MAX_FILE_MB=2048
# Reject a file only when bad rows are more than this percent AND at least this many.
STRIDE_MAX_BAD_ROW_PERCENT=5
STRIDE_MIN_BAD_ROWS_TO_REJECT=5

# --- Read-only staff assistant -----------------------------------------
# The model receives only explicitly selected lead context. Keep false until
# external handling of real-patient content has been formally approved.
ASSISTANT_ENABLED=false
ASSISTANT_REQUESTS_PER_MINUTE=10
# Never export patient prompts to a second observability vendor.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
OPENAI_API_KEY=
# Any OpenAI-compatible chat API.
ASSISTANT_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-5.6-luna
ASSISTANT_PHI_APPROVED=false
# Non-secret contract/security review ticket (e.g. the signed OpenAI BAA) reference.
ASSISTANT_PHI_APPROVAL_REFERENCE=

# --- Vapi ---------------------------------------------------------------
VAPI_BASE_URL=https://api.vapi.ai
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
VAPI_HMAC_SECRET=

# --- Twilio -------------------------------------------------------------
TWILIO_BASE_URL=https://api.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Demo testing: US test numbers for leads whose phone starts with +1 (own Twilio account). Empty = off.
US_VAPI_PHONE_NUMBER_ID=
US_TWILIO_ACCOUNT_SID=
US_TWILIO_AUTH_TOKEN=
US_TWILIO_FROM_NUMBER=

# --- Stride -------------------------------------------------------------
STRIDE_BASE_URL=https://demo.stridethera.com
STRIDE_API_TOKEN=

# --- Keap handoff -------------------------------------------------------
KEAP_HANDOFF_URL=https://keap-team.example.com/events
KEAP_HANDOFF_SECRET=

# --- Signing ------------------------------------------------------------
# Generate with: openssl rand -hex 32
SLOT_TOKEN_SECRET=

# --- Worker and retries -------------------------------------------------
WORKER_POLL_SECONDS=30
DB_POOL_TIMEOUT_SECONDS=5
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BASE_SECONDS=0.5
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=60
RETRY_MAX_SECONDS=3600

# Voice-agent booking engine (docs/BOOKING_ENGINE.md)
# Demo only: Stride demo slots exist 2026-05-15..2026-07-29, so testing pins "today". Never set in production.
BOOKING_TODAY_OVERRIDE=
BOOKING_HORIZON_DAYS=31
BOOKING_MIN_NOTICE_MINUTES=120
BOOKING_SYNC_SECONDS=300
BOOKING_CACHE_MAX_AGE_SECONDS=900
BOOKING_HOLD_SECONDS=300
BOOKING_STRIDE_TIMEOUT_SECONDS=6
BOOKING_TOOL_DEADLINE_SECONDS=24
BOOKING_DEFAULT_ADDRESS_1=Address not provided
BOOKING_DEFAULT_CITY=Laguna Niguel
BOOKING_DEFAULT_STATE=CA
BOOKING_DEFAULT_ZIP=92677

# Keap contact sync (docs/PHASE_2A_KEAP_DATA.md, docs/PHASE_2B_KEAP_DELIVERY.md)
# Switched off by default. Secrets go in the server .env only, never in git.
KEAP_SYNC_ENABLED=false
KEAP_CLIENT_ID=
KEAP_CLIENT_SECRET=
KEAP_REDIRECT_URI=https://stride.aibolt.ai/api/v1/keap/oauth/callback
KEAP_API_BASE_URL=https://api.infusionsoft.com/crm/rest/v2
KEAP_TOKEN_URL=https://api.infusionsoft.com/token
KEAP_AUTHORIZE_URL=https://accounts.infusionsoft.com/app/oauth/authorize
KEAP_SYNC_POLL_SECONDS=30
KEAP_SYNC_BATCH_SIZE=20
KEAP_SYNC_MAX_ATTEMPTS=3
KEAP_MAX_REQUESTS_PER_MINUTE=120
KEAP_MAX_REQUESTS_PER_DAY=40000
KEAP_PLAN_BATCH=500
# true only while testing against the Keap sandbox
KEAP_INCLUDE_TEST_LEADS=false
