# Deployed configuration for the Stride/Keap integration box.
# Copy to .env on the server and fill in the real values.

APP_ENV=production
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Database -----------------------------------------------------------
# sslmode=require is enforced when APP_ENV is a deployed environment.
SUPABASE_DB_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require

# --- Providers: everything real. Mocks are for local tests only. --------
PROVIDER_MODE=real
VAPI_MODE=real
TWILIO_MODE=real
STRIDE_MODE=real
KEAP_MODE=real

# --- Cadence acceleration (disabled in production) -----------------------
# Enable only in a controlled development environment. When enabled, test
# leads use TEST_CADENCE_DAY_MINUTES instead of real cadence days.
TEST_MODE=false
TEST_CADENCE_DAY_MINUTES=1

# --- URLs ---------------------------------------------------------------
API_BASE_URL=http://api:8000
PUBLIC_BASE_URL=https://stride.aibolt.ai

# --- Dashboard (CRM) -----------------------------------------------------
# Server-to-server token for /api/v1/dashboard/*. Generate with: openssl rand -hex 32
# Must be at least 32 characters. Never expose in a browser/NEXT_PUBLIC_* variable.
DASHBOARD_API_TOKEN=
# Browser-facing dashboard origin used to build authenticated transcript links.
DASHBOARD_PUBLIC_URL=https://rpt-frontend-pi.vercel.app

# --- Google Sheets / n8n -----------------------------------------------
# Inbound n8n requests are disabled until both values are configured.
# Generate independent secrets for each direction: openssl rand -hex 32
N8N_INTAKE_KEY_ID=rausch-pt-sheets
N8N_INTAKE_SECRET=
# Local testing only. Set true to skip HMAC intake auth when APP_ENV=development.
N8N_INTAKE_AUTH_DISABLED=false
N8N_PRACTICE_SLUG=rausch-pt

# Outbound Sheet updates are feature-gated. Keep false until the production
# n8n webhook, Google credentials, and protected Sheet columns are verified.
SHEET_SYNC_ENABLED=true
N8N_SHEET_WEBHOOK_URL=https://n8n.example.com/webhook/rpt-sheet-updates
N8N_SHEET_KEY_ID=aws-sheet-sync
N8N_SHEET_WEBHOOK_SECRET=
SHEET_SYNC_POLL_SECONDS=30
SHEET_SYNC_BATCH_SIZE=20
SHEET_SYNC_HTTP_TIMEOUT_SECONDS=10

# --- Vapi ---------------------------------------------------------------
VAPI_BASE_URL=https://api.vapi.ai
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
VAPI_HMAC_SECRET=

# --- Twilio -------------------------------------------------------------
TWILIO_BASE_URL=https://api.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Stride -------------------------------------------------------------
STRIDE_BASE_URL=https://demo.stridethera.com
STRIDE_API_TOKEN=

# --- Keap handoff -------------------------------------------------------
KEAP_HANDOFF_URL=https://keap-team.example.com/events
KEAP_HANDOFF_SECRET=

# --- Signing ------------------------------------------------------------
# Generate with: openssl rand -hex 32
SLOT_TOKEN_SECRET=

# --- Worker and retries -------------------------------------------------
WORKER_POLL_SECONDS=30
DB_POOL_TIMEOUT_SECONDS=5
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BASE_SECONDS=0.5
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=60
RETRY_MAX_SECONDS=3600
