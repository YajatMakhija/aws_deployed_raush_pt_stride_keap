                  {
                      "parameters":  {
                                         "jsCode":  "const now = Date.now();\nconst actions = {\u0027Start cadence\u0027:\u0027start_cadence\u0027,\u0027Restart cadence\u0027:\u0027restart_cadence\u0027,\u0027Do not contact\u0027:\u0027do_not_contact\u0027};\nfunction normalizePhone(value) {\n  let phone = String(value ?? \u0027\u0027).trim();\n  if (!phone || !/^\\+?[\\d\\s().-]+$/.test(phone)) return null;\n  const digits = phone.replace(/\\D/g, \u0027\u0027);\n  if (digits.startsWith(\u0027001\u0027) \u0026\u0026 digits.length === 13) phone = digits.slice(3);\n  else if (digits.startsWith(\u00271\u0027) \u0026\u0026 digits.length === 11) phone = digits.slice(1);\n  else if (digits.length === 10) phone = digits;\n  else return null;\n  return /^[2-9]\\d{2}[2-9]\\d{6}$/.test(phone) ? \u0027+1\u0027 + phone : null;\n}\nfunction normalizeDob(value) {\n  const text = String(value ?? \u0027\u0027).trim();\n  const dayFirst = text.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);\n  if (dayFirst) {\n    const day = Number(dayFirst[1]);\n    const month = Number(dayFirst[2]);\n    const year = Number(dayFirst[3]);\n    const dt = new Date(Date.UTC(year, month - 1, day));\n    if (dt.getUTCFullYear() === year \u0026\u0026 dt.getUTCMonth() === month - 1 \u0026\u0026 dt.getUTCDate() === day) {\n      return year.toString().padStart(4, \u00270\u0027) + \u0027-\u0027 + month.toString().padStart(2, \u00270\u0027) + \u0027-\u0027 + day.toString().padStart(2, \u00270\u0027);\n    }\n    return null;\n  }\n  const serial = Number(value);\n  if (!Number.isFinite(serial) || serial \u003c 1 || serial \u003e 100000) return null;\n  return new Date(Date.UTC(1899, 11, 30) + Math.floor(serial) * 86400000).toISOString().slice(0, 10);\n}\nconst output = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  const actionStatus = String(row[\u0027Action Status\u0027] ?? \u0027\u0027).trim();\n  let retryCount = 0;\n  if (actionStatus.startsWith(\u0027Processing: \u0027)) {\n    retryCount = 1;\n  } else {\n    const match = actionStatus.match(/^Retrying ([12])\\/3: /);\n    if (!match) continue;\n    retryCount = Number(match[1]);\n  }\n  const command = String(row.Action ?? \u0027\u0027).trim();\n  const requestId = String(row[\u0027Action Request ID\u0027] ?? \u0027\u0027).trim();\n  const started = Date.parse(String(row[\u0027Action Started At\u0027] ?? \u0027\u0027));\n  if (!actions[command] || !requestId || !Number.isFinite(started) || started \u003e now || now - started \u003c 120000) continue;\n  const sheetPhone = String(row[\u0027Phone Number\u0027] ?? \u0027\u0027).trim();\n  const phone = normalizePhone(sheetPhone);\n  const leadId = String(row[\u0027Lead ID\u0027] ?? \u0027\u0027).trim() || null;\n  if (!sheetPhone || !phone || (command !== \u0027Start cadence\u0027 \u0026\u0026 !leadId)) continue;\n  const dob = normalizeDob(row[\u0027Date Of Birth\u0027]);\n  output.push({json:{...row,sheetPhone,originalCommand:command,actionRequestId:requestId,actionStartedAt:new Date(started).toISOString(),retryCount,existingLeadId:leadId,requestBody:{action:actions[command],lead_id:command === \u0027Start cadence\u0027 ? null : leadId,lead:{full_name:String(row.Name ?? \u0027\u0027).trim() || null,phone,email:String(row.Email ?? \u0027\u0027).trim().toLowerCase() || null,date_of_birth:dob,location:String(row.Location ?? \u0027\u0027).trim() || null,title:String(row.Title ?? \u0027\u0027).trim() || null}}}});\n}\nreturn output;"
                                     },
                      "id":  "202b4f20-6eaf-4ee7-b5e5-9d58879f2003",
                      "name":  "Build Recovery Requests",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       -280,
                                       0
                                   ]
                  },
                  {
                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "const timestamp = Math.floor(Date.now()/1000).toString();\nconst rawBody = JSON.stringify($json.requestBody);\nconst secret = $env.RPT_N8N_INTAKE_SECRET;\nif (!secret) throw new Error(\u0027Missing RPT_N8N_INTAKE_SECRET\u0027);\nif (!globalThis.crypto?.subtle) throw new Error(\u0027Web Crypto API is unavailable in this n8n instance\u0027);\nconst encoder = new TextEncoder();\nconst key = await globalThis.crypto.subtle.importKey(\u0027raw\u0027,encoder.encode(secret),{name:\u0027HMAC\u0027,hash:\u0027SHA-256\u0027},false,[\u0027sign\u0027]);\nconst signed = await globalThis.crypto.subtle.sign(\u0027HMAC\u0027,key,encoder.encode(`${timestamp}.${rawBody}`));\nconst signatureHex = Array.from(new Uint8Array(signed)).map(byte=\u003ebyte.toString(16).padStart(2,\u00270\u0027)).join(\u0027\u0027);\nreturn {json:{...$json,rawBody,timestamp,signature:`sha256=${signatureHex}`}};"
                                     },
