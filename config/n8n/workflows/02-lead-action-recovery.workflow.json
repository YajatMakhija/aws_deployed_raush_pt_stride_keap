                  {
                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "const source = $(\u0027Sign Recovery Requests\u0027).item.json;\nconst status = Number($json.statusCode || 0);\nlet body = $json.body || {};\nif (typeof body === \u0027string\u0027) { try { body = JSON.parse(body); } catch { body = {}; } }\nconst success = status === 200 || status === 201;\nconst temporary = status === 0 || [408,425,429].includes(status) || status \u003e= 500;\nconst labels = {cadence_started:\u0027Cadence started\u0027,already_started:\u0027Already in Cadence\u0027,cadence_restarted:\u0027Cadence restarted\u0027,do_not_contact_applied:\u0027Do not contact applied\u0027};\nconst detail = typeof body.detail === \u0027string\u0027 ? body.detail : (typeof body.code === \u0027string\u0027 ? body.code : ($json.error?.message || \u0027request rejected\u0027));\nconst attemptsUsed = Number(source.retryCount || 1) + 1;\nlet actionResult = \u0027\u0027;\nlet finalStartedAt = \u0027\u0027;\nif (success) {\n  actionResult = labels[body.result] || \u0027Completed\u0027;\n} else if (temporary \u0026\u0026 attemptsUsed \u003c 3) {\n  actionResult = \u0027Retrying \u0027 + attemptsUsed + \u0027/3: \u0027 + source.originalCommand;\n  finalStartedAt = new Date().toISOString();\n} else if (temporary) {\n  actionResult = \u0027Error: backend unavailable after 3 attempts\u0027;\n} else {\n  actionResult = \u0027Error: \u0027 + String(detail).slice(0,180);\n}\nreturn {json:{...source,httpStatus:status,leadId:body.lead_id || source.existingLeadId || \u0027\u0027,actionResult,finalStartedAt}};"
                                     },
