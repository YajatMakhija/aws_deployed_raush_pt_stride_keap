                      "parameters":  {
                                         "jsCode":  "const input = $input.first();\nconst data = input.json;\nconst headers = Object.fromEntries(Object.entries(data.headers || {}).map(([key,value])=>[key.toLowerCase(),value]));\nconst reject = (authorized,status,error) => [{json:{authorized,validPayload:false,httpStatus:status,error}}];\nlet rawBody = null;\nif (typeof data.rawBody === 'string') rawBody = data.rawBody;\nelse if (input.binary?.data?.data) rawBody = Buffer.from(input.binary.data.data,'base64').toString('utf8');\nelse if (typeof data.body === 'string') rawBody = data.body;\nif (rawBody === null) return reject(false,401,'Raw request body unavailable');\nconst timestamp = String(headers['x-rpt-timestamp'] || '');\nconst received = String(headers['x-rpt-signature'] || '');\nconst keyId = String(headers['x-rpt-key-id'] || '');\nconst secret = $env.RPT_N8N_SHEET_WEBHOOK_SECRET;\nconst expectedKey = $env.RPT_N8N_SHEET_KEY_ID;\nif (!secret || !expectedKey) throw new Error('Missing webhook authentication configuration');\nconst fresh = /^\\d{10}$/.test(timestamp) && Math.abs(Math.floor(Date.now()/1000)-Number(timestamp)) <= 300;\nconst keyValid = keyId === expectedKey;\nconst signatureHex = received.startsWith('sha256=') ? received.slice(7) : '';\nlet signatureValid = false;\nif (/^[a-fA-F0-9]{64}$/.test(signatureHex)) {\n  if (!globalThis.crypto?.subtle) throw new Error('Web Crypto API is unavailable in this n8n instance');\n  const encoder = new TextEncoder();\n  const key = await globalThis.crypto.subtle.importKey('raw',encoder.encode(secret),{name:'HMAC',hash:'SHA-256'},false,['verify']);\n  const signatureBytes = new Uint8Array(signatureHex.match(/.{2}/g).map(byte=>parseInt(byte,16)));\n  signatureValid = await globalThis.crypto.subtle.verify('HMAC',key,signatureBytes,encoder.encode(`${timestamp}.${rawBody}`));\n}\nif (!fresh || !keyValid || !signatureValid) return reject(false,401,'Unauthorized');\nlet payload;\ntry { payload = JSON.parse(rawBody); } catch { return reject(true,400,'Invalid JSON'); }\nif (!payload || typeof payload !== 'object' || Array.isArray(payload)) return reject(true,400,'Invalid payload');\nconst topLevelAllowed = new Set(['event_id','occurred_at','lead_id','action_request_id','sheet']);\nconst allowedFields = new Set(['action_status','cadence_day','cadence','cadence_status','transcript_link','callback_at']);\nconst validId = value => typeof value === 'string' && value.trim().length > 0 && value.length <= 256;\nconst validOccurredAt = typeof payload.occurred_at === 'string' && Number.isFinite(Date.parse(payload.occurred_at));\nconst sheet = payload.sheet;\nconst validSheet = sheet && typeof sheet === 'object' && !Array.isArray(sheet) && Object.keys(sheet).length > 0 && Object.keys(sheet).every(key=>allowedFields.has(key) && (sheet[key] === null || (typeof sheet[key] === 'string' && sheet[key].length <= 50000)));\nconst validPayload = Object.keys(payload).every(key=>topLevelAllowed.has(key)) && validId(payload.event_id) && validOccurredAt && validId(payload.lead_id) && validId(payload.action_request_id) && validSheet;\nif (!validPayload) return reject(true,400,'Invalid payload');\nreturn [{json:{authorized:true,validPayload:true,httpStatus:200,error:'',event_id:payload.event_id.trim(),occurred_at:payload.occurred_at,lead_id:payload.lead_id.trim(),action_request_id:payload.action_request_id.trim(),sheet}}];"
