                                         "jsCode":  "const payload = $('Verify AWS Request').first().json;\nconst matches = $input.all().filter(item=>String(item.json['Action Request ID'] ?? '').trim() === payload.action_request_id);\nif (matches.length !== 1) return [{json:{lead_id:payload.lead_id,action_request_id:payload.action_request_id,event_id:payload.event_id,matchCount:matches.length,actionRequestId:''}}];\nconst row = matches[0].json;\nconst patch = payload.sheet;\nconst getValue = (key,column) => Object.prototype.hasOwnProperty.call(patch,key) ? (patch[key] ?? '') : (row[column] ?? '');\nconst actionRequestId = String(row['Action Request ID'] ?? '').trim();\nreturn [{json:{lead_id:payload.lead_id,action_request_id:payload.action_request_id,event_id:payload.event_id,matchCount:actionRequestId ? 1 : 0,actionRequestId,actionStatus:getValue('action_status','Action Status'),cadenceDay:getValue('cadence_day','Cadence Day'),cadenceEvents:getValue('cadence','Cadence events'),outcome:getValue('cadence_status','Outcome'),transcriptLink:getValue('transcript_link','Transcript Link'),callbackAt:getValue('callback_at','Callback At')}}];"
